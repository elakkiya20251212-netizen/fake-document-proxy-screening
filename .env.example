# Application
APP_NAME=Fake Document & Proxy Screening System
DEBUG=False
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/screening_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=screening_db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1

# ML Models
MODEL_PATH=./ml-models/saved_models
DOCUMENT_MODEL=document_classifier.h5
PROXY_MODEL=proxy_detector.h5

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,tiff

# Frontend
REACT_APP_API_URL=http://localhost:8000/api
